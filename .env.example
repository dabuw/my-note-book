# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- REQUIRED: Flask session signing key -----------------------------------
# Protects the "logged in" session cookie. The app refuses to start if this is
# missing or shorter than 32 characters.
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- REQUIRED: shared password for the full-access mode --------------------
# This is what a visitor types to leave guest mode and unlock everything
# (unlimited notes, editing, AI generation and translation).
# Use a long random value -- this is the only thing guarding the app.
APP_PASSWORD=

# --- Guest write permission -------------------------------------------------
# How many notes a guest (not logged in) may create per IP address.
#
#   0  = READ-ONLY showcase. Guests cannot create anything; the frontend also
#        hides the "New Note" button and the whole AI panel, so the site
#        presents as a non-interactive, view-only service. Use this while the
#        site is filed as 非交互式 (e.g. during 公安联网备案 for a personal
#        subject), then raise it again afterwards.
#   >0 = guests may create up to this many notes. Guest notes are ALWAYS forced
#        private and are only visible to the IP that created them, so visitor
#        content never becomes publicly readable UGC either way.
GUEST_NOTE_LIMIT=1

# --- AI features ------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. The key is read
# server-side only (src/llm.py) and must never reach the frontend.
#
# If the key is empty the AI features degrade gracefully instead of failing:
# /api/generate-notes still returns a note built by the local date/time parser
# (with ai_used=false + a warning), while /api/translate reports "AI 未配置".
#
# Pick ONE provider. Set LLM_MODEL explicitly -- do not rely on the default
# unless you really are using GitHub Models, or you will ask DeepSeek for a
# model named "openai/gpt-4.1-mini".

# Option A (recommended): a domestic provider -- note content stays in-country.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Option B: GitHub Models -- note content is sent abroad; a classic PAT needs
# no scopes, a fine-grained PAT needs Models -> Read (models:read).
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_API_KEY=ghp_xxx

# Seconds to wait for the upstream model. Nginx allows up to 180s for these
# routes, so anything above that is pointless.
LLM_TIMEOUT=60

# Legacy variable names, still honoured when the LLM_* ones above are empty.
# Left commented out on purpose: GITHUB_MODEL would otherwise silently supply a
# GitHub model name to a non-GitHub endpoint.
# GITHUB_TOKEN=
# GITHUB_MODEL=
# GITHUB_MODELS_ENDPOINT=

# --- Session / cookie behaviour --------------------------------------------
SESSION_LIFETIME_DAYS=7
# Keep true in production (the site is served over HTTPS by Nginx).
SESSION_COOKIE_SECURE=true
# Comma-separated allowlist. Leave empty: the SPA is served from the same
# origin as the API, so no CORS headers are needed at all.
ALLOWED_ORIGINS=

# --- Login brute-force guard (in-process, complements Nginx limit_req) -----
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- Server / gunicorn ------------------------------------------------------
PORT=5001
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
